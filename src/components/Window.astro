---
import { Icon } from "astro-icon/components";

interface Props {
    title: string;
    class: string;
}

const { title, class: className, ...rest } = Astro.props;
---

<div class:list={["absolute", "border", className]} {...rest}>
    <p
        id="window-title"
        class="absolute left-0 right-0 text-center text-xs p-1"
    >
        {title}
    </p>
    <span class="absolute right-0 top-0">
        <Icon name="close" class="size-4 m-1" />
    </span>
    <div class="h-full flex justify-center items-center">
        <slot />
    </div>
</div>
