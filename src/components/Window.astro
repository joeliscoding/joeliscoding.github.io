---
import { Icon } from "astro-icon/components";

interface Props {
    title: string;
    align: "left" | "right";
}

const { title, align } = Astro.props;

const alignProperty = align === "left" ? "left-10" : "right-10";
---

<div
    class:list={[
        alignProperty,
        "absolute",
        "h-64",
        "aspect-4/3",
        "border",
        "border-solid",
        "border-current",
    ]}
>
    <p
        id="window-title"
        class="absolute left-0 right-0 text-center text-xs p-1"
    >
        {title}
    </p>
    <span class="absolute right-0 top-0">
        <Icon name="close" class="size-4 m-1" />
    </span>
    <div class="h-full flex justify-center items-center">
        <slot />
    </div>
</div>
