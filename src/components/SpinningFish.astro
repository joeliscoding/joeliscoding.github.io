---
import fs from "node:fs";
import path from "node:path";

const content = fs.readFileSync(
    path.resolve("./public/ascii/spinning-fish.txt"),
    "utf-8",
);

const frames = content
    .split(/^---$/m)
    .map((frame) => frame.replace(/^\n+|\n+$/g, ""))
    .filter((frame) => frame.length > 0);
---

<pre id="fish-ascii-art" class="font-mono text-xs">{frames[0]}</pre>

<script define:vars={{ frames }}>
    let i = 0;
    setInterval(() => {
        i = (i + 1) % frames.length;
        document.getElementById("fish-ascii-art").textContent = frames[i];
    }, 200);
</script>
