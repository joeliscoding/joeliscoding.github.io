---
import ThemeButton from "@components/ThemeButton.astro";
---

<header class="mb-16">
    <nav class="flex justify-between py-4 px-2">
        <ul class="flex gap-3">
            <li class="inline">
                <a href="/" class="text-base">home</a>
            </li>
            <li>
                <a href="/projects" class="text-base">projects</a>
            </li>
            <li>
                <a href="/blog" class="text-base">blog</a>
            </li>
        </ul>

        <ThemeButton />
    </nav>

    <hr class="secondary-text" />
</header>

<style lang="scss">
    a {
        text-decoration: none;
        transition: opacity 0.1s ease-in-out;
        &:hover {
            opacity: var(--hover-opacity);
        }
    }
</style>
