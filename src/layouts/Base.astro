---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
    title: string;
    description: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead {...props} />
    </head>

    <body>
        <div
            id="container"
            class="w-auto max-w-2/3 m-auto min-h-screen flex flex-col"
        >
            <Header />

            <main class="flex-1">
                <slot />
            </main>

            <Footer />
        </div>
    </body>
</html>
