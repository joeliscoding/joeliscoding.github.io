---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";

interface Props {
    title: string;
    description: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead {...props} />
    </head>

    <body>
        <div id="container" class="w-auto max-w-2/3 m-auto">
            <Header />

            <slot />
        </div>
    </body>
</html>
